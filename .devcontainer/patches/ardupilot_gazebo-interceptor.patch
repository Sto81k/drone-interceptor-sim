+   <!-- Надлегка камера комп'ютерного зору -->
+    <link name="camera_link">
+      <inertial>
+        <mass>0.01</mass>
+        <inertia>
+          <ixx>0.0001</ixx>
+          <iyy>0.0001</iyy>
+          <izz>0.0001</izz>
+        </inertia>
+      </inertial>
+      <pose>0.35 0 -0.06 0 0.15 0</pose>
